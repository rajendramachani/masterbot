# Masterbot Event Handler Configuration
# Copy to .env and fill in values. Never commit .env!

# Authentication key for /webhook endpoint (generate: openssl rand -hex 32)
API_KEY=your_random_api_key_here

# GitHub Personal Access Token (scopes: repo, workflow)
GH_TOKEN=ghp_your_token_here

# Target GitHub repository (where masterbot manages branches and PRs)
GH_OWNER=your_github_org_or_user
GH_REPO=your_repo_name

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Secret for validating Telegram webhooks (generate: openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Verification code for getting your chat ID (e.g., verify-abc12345)
TELEGRAM_VERIFICATION=

# Your Telegram chat ID (restricts bot to your chat only)
# Get it by messaging your bot with the TELEGRAM_VERIFICATION code above
TELEGRAM_CHAT_ID=

# Secret for GitHub Actions webhook auth (must match GH_WEBHOOK_SECRET Actions secret)
GH_WEBHOOK_SECRET=

# OpenRouter API key (primary LLM provider)
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your_key_here

# LLM model for chat and planning (default: openai/gpt-4o-mini)
# Examples: openai/gpt-4o, anthropic/claude-3.5-sonnet, google/gemini-flash-1.5
# EVENT_HANDLER_MODEL=openai/gpt-4o-mini

# Server port (default: 3000)
PORT=3000

# Timeout in milliseconds for GitHub API calls (default: 30000)
GH_API_TIMEOUT_MS=30000
